# Copy this file to .env and fill in real values. Never commit .env.
# Generate a SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=
FLASK_ENV=development

# Optional: auto-create this account at startup, to log in without
# going through /auth/inscription. Leave unset to disable.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
